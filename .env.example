# Atlassian account email tied to the API token (used for the REST API)
BITBUCKET_EMAIL=you@example.com

# Bitbucket account USERNAME (not the email). Only needed for the HTTPS git tools
# (clone_repo_https / git_push_https): git over HTTPS authenticates as username:token.
# BITBUCKET_USERNAME=your-username

# Scoped Atlassian API token (id.atlassian.com/manage-profile/security/api-tokens)
# Scopes: account, repository, repository:write, repository:admin,
#         pullrequest, pullrequest:write, pipeline, pipeline:write,
#         pipeline:variable, webhook
BITBUCKET_API_TOKEN=

# Default workspace (overridable per tool call)
BITBUCKET_WORKSPACE=your-workspace

# Optional default repo. Leave unset to require an explicit `repo` on every
# tool call (recommended when you work across many repos).
# BITBUCKET_DEFAULT_REPO=

# Set to "true" to block every write/destructive tool
BITBUCKET_READ_ONLY=false

# Comma-separated branches that can never be directly mutated
# (git_push / git_rebase / delete_branch / create_branch). Default main,dev.
# PRs can still be merged into them with confirm:true.
BITBUCKET_PROTECTED_BRANCHES=main,dev
