{
  "name": "@marcusyoda/bitbucket-mcp",
  "version": "0.2.0",
  "description": "MCP server for Bitbucket Cloud: repos, PRs, comments, branches, pipelines, webhooks and variables",
  "type": "module",
  "license": "MIT",
  "author": "Marcus Gonçalves <marcusyoda13@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcusyoda/bitbucket-mcp.git"
  },
  "homepage": "https://github.com/marcusyoda/bitbucket-mcp#readme",
  "bugs": {
    "url": "https://github.com/marcusyoda/bitbucket-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bitbucket",
    "bitbucket-cloud",
    "pull-request",
    "code-review",
    "pipelines",
    "claude",
    "ai-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "bitbucket-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsup": "^8.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
