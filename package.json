{
  "name": "@marcusyoda/bitbucket-mcp",
  "version": "0.1.0",
  "description": "MCP server for Bitbucket Cloud: PRs, comments, branches, pipelines, webhooks and variables",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Marcus Gonçalves <marcusyoda13@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "bitbucket-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
